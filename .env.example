# Copy to .env.local and fill in values. Never commit .env.local or real secrets.
# Get local values by running `npm run db:start` and then `npm run db:status`.

# --- Public (shipped to the browser; must start with NEXT_PUBLIC_) ---
# Local Supabase API URL (port is set in supabase/config.toml).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:14321
# Supabase publishable key ("PUBLISHABLE_KEY" in `db:status`). Safe for the browser;
# access is controlled by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (NEVER prefix with NEXT_PUBLIC_, never import in client code) ---
# Supabase secret key ("SECRET_KEY" in `db:status`). Bypasses Row Level Security.
# Used only by the provisioning scripts (npm run user:create-admin / user:create-rider) and by
# integration and end-to-end tests that create accounts. The web app does not use it yet.
# Optional for running the app; required for those scripts and tests.
SUPABASE_SECRET_KEY=

# --- Tests only ---
# Postgres connection for `npm run test:db`. Defaults to the local Supabase database
# (port set in supabase/config.toml), so it normally does not need to be set.
# TEST_DATABASE_URL=
